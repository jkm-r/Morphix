<Window x:Class="Morphix.App.Views.ProfilBearbeitenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dom="clr-namespace:Morphix.Core.Domaene;assembly=Morphix.Core"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:k="clr-namespace:Morphix.App.Konverter"
        Title="{Binding Titel}" Width="760" Height="720" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>

        <!-- Eingabefeld: roter Rahmen, solange im Tag (gebunden an den Fehlertext) etwas steht -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource NichtLeer}}" Value="True">
                    <Setter Property="BorderBrush" Value="#C62828" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Fehlertext: nur sichtbar, wenn nicht leer -->
        <Style x:Key="Fehlertext" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C62828" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Platzhaltertext: liegt über dem Eingabefeld und ist nur sichtbar, solange der Wert (im Tag) leer ist -->
        <Style x:Key="Platzhalter" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Feldbeschriftung über den Eingabefeldern der Listen -->
        <Style x:Key="Feldbeschriftung" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Margin" Value="0,0,6,2" />
        </Style>

        <Style x:Key="Abschnitt" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>

        <ObjectDataProvider x:Key="Quellentypen" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="dom:LogquellenTyp" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock Text="{Binding SpeicherFehler}" Style="{StaticResource Fehlertext}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <Button Content="Speichern" Command="{Binding SpeichernCommand}" IsDefault="True" Padding="22,6" Margin="0,0,10,0" />
            <Button Content="Abbrechen" Command="{Binding AbbrechenCommand}" IsCancel="True" Padding="22,6" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Dies ist ein Demo-Profil: Dienste werden nur simuliert."
                           Visibility="{Binding IstDemo, Converter={StaticResource BoolZuSichtbarkeit}}"
                           Background="#FFF3D6" Padding="8,5" Margin="0,0,0,10" />

                <TextBlock Text="Name" FontWeight="SemiBold" />
                <Grid>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding NameFehler}" />
                    <TextBlock Style="{StaticResource Platzhalter}" Tag="{Binding Name}"
                               Text="Eindeutiger Name, 3 bis 50 Zeichen (z. B. Anwendungsserver Werk 1)" />
                </Grid>
                <TextBlock Text="{Binding NameFehler}" Style="{StaticResource Fehlertext}" />

                <TextBlock Text="Beschreibung" FontWeight="SemiBold" Margin="0,10,0,0" />
                <Grid>
                    <TextBox Text="{Binding Beschreibung, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinLines="2" MaxLines="4" />
                    <TextBlock Style="{StaticResource Platzhalter}" Tag="{Binding Beschreibung}"
                               VerticalAlignment="Top" Margin="7,4,0,0"
                               Text="Optional: kurze Beschreibung des Systems" />
                </Grid>

                <!-- Logquellen -->
                <TextBlock Text="Logquellen" Style="{StaticResource Abschnitt}" />
                <ItemsControl ItemsSource="{Binding Logquellen}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Typ" Style="{StaticResource Feldbeschriftung}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Ordner" Style="{StaticResource Feldbeschriftung}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Dateimuster" Style="{StaticResource Feldbeschriftung}" />
                                <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Source={StaticResource Quellentypen}}"
                                          SelectedItem="{Binding Typ}" Margin="0,0,6,0" />
                                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,6,0">
                                    <TextBox Text="{Binding Pfad, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="{Binding PfadFehler}" ToolTip="Ordner mit Logdateien bzw. Protokollname" />
                                    <TextBlock Style="{StaticResource Platzhalter}" Tag="{Binding Pfad}"
                                               Text="z. B. C:\Programme\Anwendung\Logs" />
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,6,0">
                                    <TextBox Text="{Binding Dateimuster, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="{Binding DateimusterFehler}" ToolTip="Dateimuster, z. B. *.log" />
                                    <TextBlock Style="{StaticResource Platzhalter}" Tag="{Binding Dateimuster}" Text="z. B. *.log" />
                                </Grid>
                                <Button Grid.Row="1" Grid.Column="3" Content="Entfernen" Padding="8,3" VerticalAlignment="Top"
                                        Command="{Binding DataContext.LogquelleEntfernenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PfadFehler}" Style="{StaticResource Fehlertext}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DateimusterFehler}" Style="{StaticResource Fehlertext}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding LogquellenFehler}" Style="{StaticResource Fehlertext}" />
                <Button Content="Logquelle hinzufügen" Command="{Binding LogquelleHinzufuegenCommand}"
                        HorizontalAlignment="Left" Padding="10,3" Margin="0,4,0,0" />

                <!-- Dienste -->
                <TextBlock Text="Dienste" Style="{StaticResource Abschnitt}" />
                <ItemsControl ItemsSource="{Binding Dienste}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Dienstname (technisch, z.B. Spooler)" Style="{StaticResource Feldbeschriftung}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Anzeigename" Style="{StaticResource Feldbeschriftung}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="kritisch" Style="{StaticResource Feldbeschriftung}" />
                                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                                    <TextBox Text="{Binding Dienstname, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="{Binding DienstnameFehler}" ToolTip="Technischer Dienstname" />
                                    <TextBlock Style="{StaticResource Platzhalter}" Tag="{Binding Dienstname}" Text="z. B. Spooler" />
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,6,0">
                                    <TextBox Text="{Binding Anzeigename, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Anzeigename (optional)" />
                                    <TextBlock Style="{StaticResource Platzhalter}" Tag="{Binding Anzeigename}"
                                               Text="z. B. Druckwarteschlange" />
                                </Grid>
                                <CheckBox Grid.Row="1" Grid.Column="2" Content="ja" IsChecked="{Binding IstKritisch}"
                                          ToolTip="Kritische Dienste werden hervorgehoben, wenn sie nicht laufen."
                                          VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Grid.Row="1" Grid.Column="3" Content="Entfernen" Padding="8,3" VerticalAlignment="Top"
                                        Command="{Binding DataContext.DienstEntfernenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding DienstnameFehler}" Style="{StaticResource Fehlertext}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding DiensteFehler}" Style="{StaticResource Fehlertext}" />
                <Button Content="Dienst hinzufügen" Command="{Binding DienstHinzufuegenCommand}"
                        HorizontalAlignment="Left" Padding="10,3" Margin="0,4,0,0" />

                <!-- Aufgaben -->
                <TextBlock Text="Geplante Aufgaben (optional)" Style="{StaticResource Abschnitt}" />
                <ItemsControl ItemsSource="{Binding Aufgaben}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0,0,6,0">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Name der Aufgabe in der Aufgabenplanung" />
                                    <TextBlock Style="{StaticResource Platzhalter}" Tag="{Binding Name}"
                                               Text="Name der Aufgabe in der Aufgabenplanung" />
                                </Grid>
                                <Button Grid.Column="1" Content="Entfernen" Padding="8,3"
                                        Command="{Binding DataContext.AufgabeEntfernenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Aufgabe hinzufügen" Command="{Binding AufgabeHinzufuegenCommand}"
                        HorizontalAlignment="Left" Padding="10,3" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
