<UserControl x:Class="Morphix.App.Views.AufgabenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Meldungstext" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- US11: fehlgeschlagene Aufgabe (GR08) rot. Die Zelle bekommt die Farbe selbst, damit die Auswahl sie nicht überdeckt. -->
        <Style x:Key="AufgabenZeile" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstFehlgeschlagen}" Value="True">
                    <Setter Property="Foreground" Value="#8E1B1B" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AufgabenZelle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstFehlgeschlagen}" Value="True">
                    <Setter Property="Background" Value="#FDE7E7" />
                    <Setter Property="Foreground" Value="#8E1B1B" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IstFehlgeschlagen}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#F5BDBD" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="22,18">
        <TextBlock DockPanel.Dock="Top" Text="Aufgaben" FontSize="17" FontWeight="SemiBold" />

        <Border DockPanel.Dock="Top" Background="#FDE7E7" BorderBrush="#D04848" BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,10,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FehlerHinweis}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding FehlerHinweis}" Foreground="#8E1B1B" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Hinweis}" Style="{StaticResource Meldungstext}" Foreground="#555" />

        <DataGrid ItemsSource="{Binding Aufgaben}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E4E4E4"
                  Background="Transparent" HeadersVisibility="Column" BorderBrush="#D0D0D0"
                  HorizontalScrollBarVisibility="Disabled"
                  RowStyle="{StaticResource AufgabenZeile}" CellStyle="{StaticResource AufgabenZelle}" Margin="0,12,0,0">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#EDEDED" />
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Aufgabe" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Letzter Lauf" Binding="{Binding LetzterLaufText}" Width="150" />
                <DataGridTextColumn Header="Ergebnis" Binding="{Binding ErgebnisText}" Width="200" />
                <DataGridTextColumn Header="Nächster Lauf" Binding="{Binding NaechsterLaufText}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
