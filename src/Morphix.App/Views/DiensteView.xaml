<UserControl x:Class="Morphix.App.Views.DiensteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Meldungstext" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- US09: kritischer, gestoppter Dienst farblich hervorgehoben -->
        <Style x:Key="DienstZeile" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstKritischGestoppt}" Value="True">
                    <Setter Property="Background" Value="#FDE7E7" />
                    <Setter Property="Foreground" Value="#8E1B1B" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Die Zellen haben eigene Hintergründe (v. a. für die Auswahl). Ohne diesen Stil überdeckt
             die graue Auswahlfarbe die rote Zeile, sobald der Dienst angeklickt ist. -->
        <Style x:Key="DienstZelle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstKritischGestoppt}" Value="True">
                    <Setter Property="Background" Value="#FDE7E7" />
                    <Setter Property="Foreground" Value="#8E1B1B" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IstKritischGestoppt}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#F5BDBD" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="22,18">
        <TextBlock DockPanel.Dock="Top" Text="Dienste" FontSize="17" FontWeight="SemiBold" />

        <!-- US09: Warnung bei gestopptem kritischem Dienst -->
        <Border DockPanel.Dock="Top" Background="#FDE7E7" BorderBrush="#D04848" BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,10,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding KritischHinweis}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding KritischHinweis}" Foreground="#8E1B1B" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <!-- Aktionen -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Starten" Command="{Binding StartenCommand}" Padding="18,6" Margin="0,0,8,0" />
                <Button Content="Stoppen" Command="{Binding StoppenCommand}" Padding="18,6" Margin="0,0,8,0" />
                <Button Content="Neustarten" Command="{Binding NeustartenCommand}" Padding="18,6" />
            </StackPanel>
            <TextBlock Text="{Binding RechteHinweis}" Style="{StaticResource Meldungstext}" Foreground="#8A5A00" />
            <TextBlock Text="{Binding Meldung}" Style="{StaticResource Meldungstext}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding LeerHinweis}" Style="{StaticResource Meldungstext}" Foreground="#555" />

        <DataGrid ItemsSource="{Binding Dienste}" SelectedItem="{Binding AusgewaehlterDienst}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E4E4E4" Background="Transparent"
                  HeadersVisibility="Column" BorderBrush="#D0D0D0"
                  HorizontalScrollBarVisibility="Disabled"
                  RowStyle="{StaticResource DienstZeile}" CellStyle="{StaticResource DienstZelle}" Margin="0,12,0,0">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#EDEDED" />
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dienst" Binding="{Binding Name}" Width="140" />
                <DataGridTextColumn Header="Dienstname" Binding="{Binding Dienstname}" Width="130" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="85" />
                <DataGridTextColumn Header="Starttyp" Binding="{Binding StarttypText}" Width="95" />
                <DataGridTextColumn Header="Kritisch" Binding="{Binding Kritisch}" Width="65" />
                <!-- Restbreite: Der Hinweis füllt den übrigen Platz, lange Texte werden umbrochen -->
                <DataGridTextColumn Header="Hinweis" Binding="{Binding Hinweis}" Width="*" MinWidth="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
