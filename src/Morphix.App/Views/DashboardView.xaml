<UserControl x:Class="Morphix.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Kennzahl-Kachel wie im Mock-up: große Zahl, darunter Beschriftung -->
        <Style x:Key="Kachel" TargetType="Border">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="22,18">
        <TextBlock Text="Übersicht für den gewählten Zeitraum" FontSize="17" FontWeight="SemiBold" />

        <!-- Kennzahlen; die Werte werden in M4 vom DashboardViewModel gefüllt -->
        <UniformGrid Rows="1" Margin="0,14,-16,0">
            <Border Style="{StaticResource Kachel}" BorderBrush="#C8C8C8">
                <StackPanel>
                    <TextBlock Text="–" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Fehler im Zeitraum" Foreground="#555" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Kachel}" BorderBrush="#D04848">
                <StackPanel>
                    <TextBlock Text="–" FontSize="28" FontWeight="Bold" Foreground="#C62828" />
                    <TextBlock Text="Kritische Dienste gestoppt" Foreground="#555" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Kachel}" BorderBrush="#F2B84B">
                <StackPanel>
                    <TextBlock Text="–" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Aufgaben fehlgeschlagen" Foreground="#555" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Text="Häufigste Fehlergruppen" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,8" />
        <!-- Kopfzeile der Tabelle; Zeilen folgen in M4 -->
        <Border Background="#EDEDED" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Anzahl" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Meldungsmuster" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Quelle" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="Zuletzt" FontWeight="SemiBold" />
            </Grid>
        </Border>
        <TextBlock Text="Noch keine Analyse durchgeführt." Foreground="#777" Margin="10,10,0,0" />
    </StackPanel>
</UserControl>
