<UserControl x:Class="Morphix.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Kennzahl-Kachel wie im Mock-up: große Zahl, darunter Beschriftung -->
        <Style x:Key="Kachel" TargetType="Border">
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="22,18">
        <TextBlock DockPanel.Dock="Top" Text="Übersicht für den gewählten Zeitraum" FontSize="17" FontWeight="SemiBold" />

        <!-- Kennzahlen -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,14,-16,0">
            <Border Style="{StaticResource Kachel}" BorderBrush="#C8C8C8">
                <StackPanel>
                    <TextBlock Text="{Binding FehlerAnzahl}" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="{Binding FehlerText}" Foreground="#555" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Kachel}" BorderBrush="#D04848">
                <StackPanel>
                    <TextBlock Text="{Binding GestoppteKritischeDienste}" FontSize="28" FontWeight="Bold" Foreground="#C62828" />
                    <TextBlock Text="{Binding KritischeDiensteText}" Foreground="#555" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Kachel}" BorderBrush="#F2B84B">
                <StackPanel>
                    <TextBlock Text="{Binding FehlgeschlageneAufgaben}" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="{Binding AufgabenText}" Foreground="#555" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock DockPanel.Dock="Top" Text="Häufigste Fehlergruppen" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,8" />

        <Button DockPanel.Dock="Bottom" Content="Bericht erstellen" Command="{Binding BerichtErstellenCommand}"
                HorizontalAlignment="Right" Padding="18,7" Margin="0,12,0,0" FontWeight="SemiBold" />

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Hinweis}" Foreground="#555" TextWrapping="Wrap" Margin="2,10,0,0" />

        <DataGrid ItemsSource="{Binding HaeufigsteGruppen}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E4E4E4"
                  BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                  CanUserAddRows="False" SelectionMode="Single" VerticalAlignment="Top">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#EDEDED" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Anzahl" Binding="{Binding Anzahl}" Width="80" />
                <DataGridTextColumn Header="Meldungsmuster" Binding="{Binding Meldungsmuster}" Width="*" />
                <DataGridTextColumn Header="Quelle" Binding="{Binding Quelle}" Width="220" />
                <DataGridTextColumn Header="Zuletzt" Binding="{Binding LetztesAuftreten, StringFormat='dd.MM. HH:mm'}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
