<Window x:Class="Morphix.App.Views.BestaetigungsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="JaButton" Content="Ja" IsDefault="False" Padding="26,6" Margin="0,0,10,0" Click="Ja_Click" />
            <Button Content="Abbrechen" IsCancel="True" IsDefault="True" Padding="18,6" />
        </StackPanel>
        <TextBlock x:Name="Frage" TextWrapping="Wrap" FontSize="15" />
    </DockPanel>
</Window>
