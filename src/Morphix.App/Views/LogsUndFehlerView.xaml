<UserControl x:Class="Morphix.App.Views.LogsUndFehlerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Fehlertext" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C62828" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Suchfeld: roter Rahmen, solange der Fehlertext im Tag nicht leer ist -->
        <Style x:Key="Suchfeld" TargetType="TextBox">
            <Setter Property="Padding" Value="3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource NichtLeer}}" Value="True">
                    <Setter Property="BorderBrush" Value="#C62828" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EDEDED" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="22,18">
        <TextBlock DockPanel.Dock="Top" Text="Logs und Fehler" FontSize="17" FontWeight="SemiBold" />

        <!-- Filterleiste: wirkt sofort bei jeder Änderung -->
        <Grid DockPanel.Dock="Top" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock Text="Schweregrad" Foreground="#555" />
                <ComboBox ItemsSource="{Binding Schweregrade}" DisplayMemberPath="Titel"
                          SelectedItem="{Binding AusgewaehlterSchweregrad}" Width="170" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                <TextBlock Text="Suchbegriff (Meldung oder Quelle)" Foreground="#555" />
                <TextBox Text="{Binding Suchbegriff, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding SuchbegriffFehler}" Style="{StaticResource Suchfeld}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding SuchbegriffFehler}" Style="{StaticResource Fehlertext}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Von (Tag)" Foreground="#555" />
                    <DatePicker SelectedDate="{Binding VonTag}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Bis (Tag)" Foreground="#555" />
                    <DatePicker SelectedDate="{Binding BisTag}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Zusammenfassung}" Foreground="#555" Margin="0,10,0,6" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>

            <!-- Fehlergruppen; Doppelklick zeigt die zugehörigen Einträge -->
            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Top" Text="Fehlergruppen (Doppelklick zeigt die Einträge)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <DataGrid x:Name="GruppenTabelle" ItemsSource="{Binding Gruppen}" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E4E4E4" Background="Transparent" RowBackground="Transparent"
                          HeadersVisibility="Column" BorderBrush="#D0D0D0">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding GruppeOeffnenCommand}"
                                      CommandParameter="{Binding SelectedItem, ElementName=GruppenTabelle}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Anzahl" Binding="{Binding Anzahl}" Width="70" />
                        <DataGridTextColumn Header="Meldungsmuster" Binding="{Binding Meldungsmuster}" Width="*" />
                        <DataGridTextColumn Header="Quelle" Binding="{Binding Quelle}" Width="200" />
                        <DataGridTextColumn Header="Erstes Auftreten" Binding="{Binding ErstesAuftreten, StringFormat='dd.MM. HH:mm'}" Width="120" />
                        <DataGridTextColumn Header="Zuletzt" Binding="{Binding LetztesAuftreten, StringFormat='dd.MM. HH:mm'}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,10,0,4">
                <Button DockPanel.Dock="Right" Content="Alle Einträge anzeigen" Command="{Binding AlleEintraegeAnzeigenCommand}"
                        Padding="10,2" />
                <TextBlock Text="{Binding EintraegeTitel}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- Einträge der gewählten Gruppe bzw. alle gefilterten Einträge -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding Eintraege}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E4E4E4" Background="Transparent" RowBackground="Transparent"
                      HeadersVisibility="Column" BorderBrush="#D0D0D0"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Zeit" Binding="{Binding Zeitstempel, StringFormat='dd.MM.yyyy HH:mm:ss'}" Width="150" />
                    <DataGridTextColumn Header="Schweregrad" Binding="{Binding Schweregrad}" Width="95" />
                    <DataGridTextColumn Header="Quelle" Binding="{Binding Quelle}" Width="200" />
                    <DataGridTextColumn Header="Meldung" Binding="{Binding Meldung}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
