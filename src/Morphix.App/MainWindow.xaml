<Window x:Class="Morphix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Morphix" Width="1100" Height="700" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Kopfleiste -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="#F3F3F3" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Profil:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="260" ItemsSource="{Binding Profile}" SelectedItem="{Binding AusgewaehltesProfil}"
                          VerticalAlignment="Center" />
                <TextBlock Text="Von:" VerticalAlignment="Center" Margin="16,0,6,0" />
                <DatePicker SelectedDate="{Binding ZeitraumVon}" VerticalAlignment="Center" />
                <TextBlock Text="Bis:" VerticalAlignment="Center" Margin="12,0,6,0" />
                <DatePicker SelectedDate="{Binding ZeitraumBis}" VerticalAlignment="Center" />
                <Button Content="Analyse starten" Command="{Binding AnalyseStartenCommand}"
                        Margin="16,0,0,0" Padding="14,4" VerticalAlignment="Center" />
                <Border Background="#FFE9A8" CornerRadius="3" Padding="8,2" Margin="16,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IstDemoModus, Converter={StaticResource BoolZuSichtbarkeit}}">
                    <TextBlock Text="Demo-Modus" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Statusleiste -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Statusmeldung}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Navigation links -->
        <ListBox DockPanel.Dock="Left" Width="180" ItemsSource="{Binding Navigation}"
                 SelectedItem="{Binding AusgewaehlterEintrag}" BorderThickness="0,0,1,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Titel}" Padding="8,6" FontSize="14" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Inhaltsbereich: das DataTemplate zum ViewModel wählt die Ansicht -->
        <ContentControl Content="{Binding AktuelleAnsicht}" />
    </DockPanel>
</Window>
