<Window x:Class="Morphix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Morphix" Width="1100" Height="700" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AkzentBrush" Color="#1F6FDB" />
        <SolidColorBrush x:Key="AuswahlBrush" Color="#E3EEFB" />

        <!-- Hervorgehobener Hauptbutton wie im Mock-up -->
        <Style x:Key="AkzentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AkzentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Rahmen" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Rahmen" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigationseintrag: ausgewählter Eintrag hell hinterlegt und fett -->
        <Style x:Key="NavigationEintrag" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Rahmen" CornerRadius="3" Padding="10,8" Background="Transparent">
                            <ContentPresenter TextElement.FontSize="15" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="#F0F4FA" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource AuswahlBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Datumsfeld des Zeitraums: roter Rahmen, solange der Zeitraum ungültig ist (GR01) -->
        <Style x:Key="ZeitraumFeld" TargetType="DatePicker">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource NichtLeer}}" Value="True">
                    <Setter Property="BorderBrush" Value="#C62828" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Kopfleiste: Demo-Hinweis, Profil, Zeitraum, Analyse starten (rechts) -->
        <Border DockPanel.Dock="Top" Padding="14,10" Background="White"
                BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Left" Background="#FFF3D6" BorderBrush="#F2B84B" BorderThickness="1"
                        CornerRadius="14" Padding="16,5" Margin="0,0,14,0" VerticalAlignment="Center"
                        Visibility="{Binding IstDemoModus, Converter={StaticResource BoolZuSichtbarkeit}}">
                    <TextBlock Text="Demo-Modus" FontWeight="SemiBold" />
                </Border>
                <ComboBox DockPanel.Dock="Left" Width="260" ItemsSource="{Binding Profile}" DisplayMemberPath="Name"
                          SelectedItem="{Binding AusgewaehltesProfil}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Left" Content="Bearbeiten" Command="{Binding ProfilBearbeitenCommand}"
                        Margin="6,0,0,0" Padding="8,3" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Left" Content="Neu" Command="{Binding ProfilNeuCommand}"
                        Margin="6,0,0,0" Padding="8,3" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="von" VerticalAlignment="Center" Margin="14,0,6,0" />
                <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding ZeitraumVon}" VerticalAlignment="Center"
                            Tag="{Binding ZeitraumFehler}" Style="{StaticResource ZeitraumFeld}" ToolTip="{Binding ZeitraumFehler}" />
                <TextBlock DockPanel.Dock="Left" Text="bis" VerticalAlignment="Center" Margin="12,0,6,0" />
                <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding ZeitraumBis}" VerticalAlignment="Center"
                            Tag="{Binding ZeitraumFehler}" Style="{StaticResource ZeitraumFeld}" ToolTip="{Binding ZeitraumFehler}" />
                <Button DockPanel.Dock="Right" Content="Analyse starten" Style="{StaticResource AkzentButton}"
                        Command="{Binding AnalyseStartenCommand}" />
            </DockPanel>
        </Border>

        <!-- Statusleiste -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
            <StatusBarItem Padding="10,4">
                <TextBlock Text="{Binding Statusmeldung}" />
            </StatusBarItem>
            <StatusBarItem Padding="10,4">
                <TextBlock Text="{Binding ZeitraumFehler}" Foreground="#C62828" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" Padding="10,4" HorizontalAlignment="Right"
                           Visibility="{Binding IstAnalyseLaeuft, Converter={StaticResource BoolZuSichtbarkeit}}">
                <ProgressBar Width="160" Height="14" Minimum="0" Maximum="100" Value="{Binding Fortschritt, Mode=OneWay}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Navigation links -->
        <ListBox DockPanel.Dock="Left" Width="190" ItemsSource="{Binding Navigation}"
                 SelectedItem="{Binding AusgewaehlterEintrag}" ItemContainerStyle="{StaticResource NavigationEintrag}"
                 BorderBrush="#D0D0D0" BorderThickness="0,0,1,0" Padding="0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Titel}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Inhaltsbereich: das DataTemplate zum ViewModel wählt die Ansicht -->
        <ContentControl Content="{Binding AktuelleAnsicht}" />
    </DockPanel>
</Window>
